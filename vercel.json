{
  "cleanUrls": true,
  "images": {
    "sizes": [640, 828, 1200, 1920],
    "domains": ["theflyingengineer.com"],
    "formats": ["image/webp"],
    "minimumCacheTTL": 86400
  },
  "rewrites": [
    { "source": "/flight/:id", "destination": "/flight" },
    { "source": "/feed/empty-legs.json", "destination": "https://wscowiseslaovmmfuzyv.supabase.co/functions/v1/public-feed" },
    { "source": "/feed/empty-legs.csv", "destination": "https://wscowiseslaovmmfuzyv.supabase.co/functions/v1/public-feed?format=csv" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
